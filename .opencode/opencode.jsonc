{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "gitnexus_*": false,
    "playwright_*": false,
    "sonarqube_*": false,
    "jira-mcp_*": false,
    "codescene_*": false,
    "github_*": false,
    "apexcharts_*": false,
    "open-design_*": false
  },
  "agent": {
    "gitnexus": {
      "description": "gitnexus operations",
      "mode": "subagent",
      "tools": {
        "gitnexus_*": true
      }
    },
    "playwright": {
      "description": "playwright operations",
      "mode": "subagent",
      "tools": {
        "playwright_*": true
      }
    },
    "sonarqube": {
      "description": "sonarqube operations",
      "mode": "subagent",
      "tools": {
        "sonarqube_*": true
      }
    },
    "jira-mcp": {
      "description": "jira-mcp operations",
      "mode": "subagent",
      "tools": {
        "jira-mcp_*": true
      }
    },
    "codescene": {
      "description": "codescene operations",
      "mode": "subagent",
      "tools": {
        "codescene_*": true
      }
    },
    "github": {
      "description": "github operations",
      "mode": "subagent",
      "tools": {
        "github_*": true
      }
    },
    "apexcharts": {
      "description": "apexcharts operations",
      "mode": "subagent",
      "tools": {
        "apexcharts_*": true
      }
    },
    "open-design": {
      "description": "open-design operations",
      "mode": "subagent",
      "tools": {
        "open-design_*": true
      }
    }
  }
}